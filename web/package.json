{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "pnpm routes:generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm routes:generate && tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lingui:extract": "lingui extract",
    "routes:generate": "tsr generate",
    "api:types": "node scripts/gen-api-types.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@lingui/core": "^5.3.2",
    "@lingui/react": "^5.3.2",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-router": "^1.130.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.0",
    "lucide-react": "^0.536.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@lingui/babel-plugin-lingui-macro": "^5.3.2",
    "@lingui/cli": "^5.3.2",
    "@lingui/vite-plugin": "^5.3.2",
    "@smithy/types": "^4.18.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query-devtools": "^5.84.1",
    "@tanstack/router-cli": "^1.130.2",
    "@tanstack/router-devtools": "^1.130.2",
    "@tanstack/router-plugin": "^1.130.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  }
}
