# ---- Required ---------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret used to sign JWT access tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# ---- Optional (defaults shown) ----------------------------------------------
# Public hostname + port served by nginx
APP_HOST=assistant.localhost
NGINX_PORT=80

# Postgres (used by the db container and by api/worker)
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant

# Gemini models
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Thinking level of the chat model: minimal, low, medium or high (billed as output tokens)
GEMINI_THINKING_LEVEL=medium
# Changing the embedding model requires re-embedding stored vectors: cd api && uv run python -m app.db.reembed
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
# Timeout per Gemini request in milliseconds (chat, summary, embeddings)
GEMINI_TIMEOUT_MS=60000
# Context window of the chat model (used to report % used per call) and the prompt budget
GEMINI_CONTEXT_WINDOW_TOKENS=1048576
CHAT_PROMPT_TOKEN_BUDGET=120000

# Retrieval
RAG_TOP_K=4
RAG_MIN_SCORE=0.55
RAG_CORRECTIONS_TOP_K=3
RAG_CORRECTIONS_MIN_SCORE=0.65
CHAT_HISTORY_WINDOW=12

# Uploads
MAX_UPLOAD_MB=10

# API processes per container (each is single-threaded; raise with CPU count)
UVICORN_WORKERS=2

# Auth: short-lived access token (Bearer) + rotated refresh token
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Seeded users (comma-separated user:password pairs)
SEED_USERS=agent1:agent1pass,agent2:agent2pass

# ---- Optional: LLM observability with a local Langfuse (docker compose --profile observability) --
# Every chat turn becomes a trace: retrieval span (query, sections + scores, corrections) and a
# generation (full prompt, raw output, tokens, latency, % of context window).
# 1. Uncomment the two keys below (they are also used to pre-create the Langfuse project).
# 2. docker compose --profile observability up -d
# 3. Open http://localhost:3001 and log in with LANGFUSE_INIT_USER_EMAIL / _PASSWORD.
# Leave the keys empty to run without tracing.
#LANGFUSE_PUBLIC_KEY=pk-lf-local-ai-support-assistant
#LANGFUSE_SECRET_KEY=sk-lf-local-ai-support-assistant
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PORT=3001
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=langfuse-admin-1
